<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Get<T>() sobre IConfigurationSection: IoC es una librería plana (Sdk normal, no Sdk.Web) y
         no trae el binder por el framework compartido de ASP.NET Core como sí lo trae Web. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <!-- services.Configure<T>(IConfigurationSection) -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
